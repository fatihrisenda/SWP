{
  "name": "@swp/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src prisma test --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:dev": "tsx prisma/seed.dev.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@swp/shared": "*",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jose": "^5.9.6",
    "luxon": "^3.5.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^2.1.4",
    "eslint": "^9.14.0",
    "pino-pretty": "^11.3.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.13.0",
    "vitest": "^2.1.4"
  }
}
